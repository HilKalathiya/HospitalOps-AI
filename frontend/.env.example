# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy to .env.local for local development.
# Variables must be prefixed with VITE_ to be exposed to the browser bundle.

# Backend API base URL.
# In development this is usually handled by the Vite proxy (see vite.config.ts).
# In production, set this to the absolute URL of your backend API.
VITE_API_BASE_URL=/api/v1

# Backend port (used by the Vite proxy)
VITE_API_PORT=8000
