# ─────────────────────────────────────────────────────────────────────────────
# HospitalOps AI — Environment Configuration Example
#
# Copy this file to .env and fill in your local values.
# NEVER commit .env or any file containing real credentials.
#
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have safe defaults or are only used in later chunks.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
# [REQUIRED] Runtime environment: development | staging | production
APP_ENV=development

# [REQUIRED] Human-readable application name
APP_NAME=HospitalOps AI

# [OPTIONAL] API route prefix
API_PREFIX=/api/v1

# [OPTIONAL] Backend server port
BACKEND_PORT=8000

# [OPTIONAL] Frontend development server port
FRONTEND_PORT=5173

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# [REQUIRED] MongoDB connection URI
# Local Docker example: mongodb://mongodb:27017
# Atlas example:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://mongodb:27017

# [REQUIRED] Database name
MONGODB_DATABASE=hospitalops

# ─── Redis ───────────────────────────────────────────────────────────────────
# [REQUIRED] Redis connection URL
REDIS_URL=redis://redis:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated list of allowed origins for CORS
# In production, restrict this to your actual frontend domain(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
# [OPTIONAL] Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Authentication ──────────────────────────────────────────────────────────
# [REQUIRED for auth] Secrets and token lifetimes
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# ─── LLM / AI (Future — Chunk TBD) ──────────────────────────────────────────
# These variables are placeholders for future chunks.
# Do not set real values here.
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=

# ─── Vector Database (Future — Chunk TBD) ────────────────────────────────────
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# ─── ML / Forecasting (Future — Chunk TBD) ───────────────────────────────────
ML_MODEL_PATH=

# ─── Notifications (Future — Chunk TBD) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
