# HospitalOps AI — Backend Development Environment
# Same as root .env.example, scoped to the backend service.
# Copy to backend/.env for local development without Docker.

APP_ENV=development
APP_NAME=HospitalOps AI
API_PREFIX=/api/v1
BACKEND_PORT=8000

# Point to local Docker services or locally-running instances
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hospitalops

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication (Development Defaults)
# In production, use strong secrets and set secure to true.
JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

LOG_LEVEL=DEBUG
